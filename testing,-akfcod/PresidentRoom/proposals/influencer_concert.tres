[gd_resource type="Resource" format=3]

[ext_resource type="Script" path="res://PresidentRoom/proposal_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "influencer_concert"
character = "The Influencer"
start = true
says = "Let me throw a concert at the park bandstand! One epic night, zero excuses!"
deny_label = "Not on my watch"
deny_money = 5
deny_bureaucracy = -5
deny_caption = "You turned down *The Influencer's concert*. No stage, no permits, no noise. The beach stays quiet tonight."
approve_label = "Let's party"
approve_money = -10
approve_bureaucracy = 15
approve_caption = "You approved *The Influencer's concert*. One epic night on the beach!"
approve_action = 2
note = "Tür: takas. Zincir: tek. Onaylanınca tek gecelik konser kurulur (beach_concert.gd): sahne, ışıklar, hoparlörler, dans eden kalabalık, havai fişek. Asıl yeri Central Park'taki çalgı köşkü; kalıcı olmadığı için şimdilik sahilde. Ertesi gün kalkar. Gösteri ~7 saniye; gün sonu metni müziğin üstünde bir kez okunur, kısa tut."
