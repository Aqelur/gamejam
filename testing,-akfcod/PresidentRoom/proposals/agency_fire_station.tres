[resource]
script = ExtResource("1_data")
id = "agency_fire_station"
character = "Head of Disaster Agency"
start = true
says = "This town doesn't have a fire station. In emergency, I need at least a station and two trucks."
deny_label = "Not in the budget"
deny_money = 15
deny_readiness = -10
deny_caption = "No *Fire Station*. When the quake hits, there are no trucks."
approve_label = "Build the station"
approve_people = 5
approve_money = -15
approve_readiness = 10
approve_caption = "The *Fire Station* is up, with two trucks ready."
approve_action = 1
city_target = "Districts/CivicCenter/Buildings/FireStation"
note = "Tür: takas. Zincir: tek. Şehirde itfaiye yok. Reddetmek kasayı rahatlatır ama hazırlık düşer. Onaylanınca Civic Center'daki arsada itfaiye yapılır."
