[ext_resource type="Script" path="res://PresidentRoom/proposal_data.gd" id="1_data"]

[resource]
script = ExtResource("1_data")
id = "interior_police"
character = "Minister of Interior"
start = true
says = "This town doesn't have a police station. Someone has to keep order and stop the looting. Sign the order and I'll have officers here by the end of the week."
deny_label = "Not now"
deny_money = 10
deny_readiness = -5
deny_bureaucracy = -5
deny_caption = "No *Police Station*. When the quake hits, nobody keeps order."
approve_label = "Sign the order"
approve_money = -10
approve_readiness = 5
approve_bureaucracy = 10
approve_caption = "The *Police Station* is up. Officers to keep the peace."
approve_action = 1
city_target = "Districts/CivicCenter/Buildings/PoliceStation"
note = "Tür: takas. Zincir: tek. Şehirde polis karakolu yok. Reddetmek kasayı rahatlatır ve bürokrasiyi azaltır ama hazırlık düşer. Onaylanınca Civic Center'daki arsada polis karakolu yapılır."
